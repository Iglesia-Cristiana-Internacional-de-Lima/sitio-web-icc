# ===========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ===========================================
# PostgreSQL local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iglesia_lima?schema=public"

# ===========================================
# RESEND - SERVICIO DE EMAIL
# ===========================================
# Obtén tu API key en https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxx"

# Email remitente (debe estar verificado en Resend)
EMAIL_FROM="Estudios Bíblicos <estudios@tu-dominio.com>"

# ===========================================
# AUTH - Secreto para firmar cookies de sesión
# Genera uno con: openssl rand -base64 32
# ===========================================
AUTH_SECRET=""

# ===========================================
# WHATSAPP
# ===========================================
# Número de WhatsApp de la iglesia (con código de país, sin +)
WHATSAPP_NUMERO="51999999999"
