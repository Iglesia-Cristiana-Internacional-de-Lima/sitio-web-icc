// Prisma Schema para Iglesia Cristiana Internacional Lima
// Módulo: Estudios Bíblicos, Eventos y Suscriptores

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// MÓDULO DE LÍDERES Y RESERVAS (Lo que ya tenías)
// ==========================================

model Lider {
  id             Int       @id @default(autoincrement())
  nombre         String
  rol            String
  especialidades String[]
  disponibilidad String
  ubicacion      String
  imagen         String?
  bio            String?
  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reservas       Reserva[]

  @@map("lideres")
}

model Reserva {
  id           Int           @id @default(autoincrement())
  nombre       String
  contacto     String
  modalidad    Modalidad
  mensaje      String?
  estado       EstadoReserva @default(PENDIENTE)

  liderId      Int
  lider        Lider         @relation(fields: [liderId], references: [id])

  emailEnviado Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("reservas")
}

// ==========================================
// MÓDULO DE EVENTOS Y SUSCRIPTORES (Las tablas recuperadas)
// ==========================================

model Evento {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("eventos")
}

model Suscriptor {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  nombre    String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("suscriptores")
}

// ==========================================
// ENUMS
// ==========================================

enum Modalidad {
  PRESENCIAL
  ONLINE
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  COMPLETADA
  CANCELADA
}