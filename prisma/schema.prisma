// Prisma Schema para Iglesia Cristiana Internacional Lima
// Módulo: Estudios Bíblicos

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Modelo de Líder de Estudios Bíblicos
model Lider {
  id            Int       @id @default(autoincrement())
  nombre        String
  rol           String
  especialidades String[]
  disponibilidad String
  ubicacion     String
  imagen        String?
  bio           String?
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relación con reservas
  reservas      Reserva[]

  @@map("lideres")
}

// Modelo de Reserva de Estudio Bíblico
model Reserva {
  id            Int       @id @default(autoincrement())
  nombre        String
  contacto      String
  modalidad     Modalidad
  mensaje       String?
  estado        EstadoReserva @default(PENDIENTE)

  // Relación con líder
  liderId       Int
  lider         Lider     @relation(fields: [liderId], references: [id])

  // Notificaciones
  emailEnviado  Boolean   @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("reservas")
}

// Enums
enum Modalidad {
  PRESENCIAL
  ONLINE
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  COMPLETADA
  CANCELADA
}
